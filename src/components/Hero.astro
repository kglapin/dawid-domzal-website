---
---
<section class="grain relative flex min-h-[75vh] flex-col items-center overflow-hidden bg-geo-900 text-white" id="top">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-blob absolute -left-[12%] -top-[12%] h-[125%] w-[55%] bg-gradient-to-br from-limebrand/25 via-limebrand/10 to-transparent" aria-hidden="true"></div>

  <svg class="pointer-events-none absolute inset-0 z-0 h-full w-full" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <path id="hero-arc" d="M 100 300 A 500 500 0 0 0 1100 300" />
    </defs>
    <text fill="rgba(255,255,255,0.07)" font-size="200" font-weight="700" letter-spacing="0.12em" text-anchor="middle" font-family="Inter, sans-serif">
      <textPath href="#hero-arc" startOffset="50%">GEODEZJA</textPath>
    </text>
  </svg>

  <div class="relative z-10 mx-auto w-full max-w-4xl px-6 pt-24 pb-10 text-center lg:pt-36">
    <div class="stagger-reveal reveal">
      <p class="mb-4 text-xs font-bold uppercase tracking-[.24em] text-limebrand">Dawid Domżał - Usługi Geodezyjne</p>
      <img src="/domzal-logo.webp" alt="Dawid Domżał – logo" class="mx-auto mb-4 h-20 w-20 rounded-full object-cover" loading="eager" />
      <h1 class="text-5xl font-semibold leading-[.95] tracking-[-0.055em] md:text-6xl lg:text-7xl">
        <span class="geo-word">Geodezja,</span><br />która porządkuje inwestycję od pierwszej mapy do odbioru.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-7 text-white/80 md:text-lg">
        Wykonuję mapy do celów projektowych, tyczenia budynków, podziały nieruchomości i inwentaryzacje powykonawcze. Pomagam inwestorom w Kaliszu i okolicach przejść przez kolejne etapy budowy konkretnie, terminowo i z jasnym planem działania.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="tel:+48501719855" class="inline-flex items-center justify-center gap-2 rounded-full bg-limebrand px-7 py-4 text-center text-sm font-semibold text-geo-900 transition hover:-translate-y-0.5 hover:shadow-soft">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Umów tyczenie budynku w Kaliszu
        </a>
        <a href="mailto:domzal-dawid@wp.pl" class="rounded-full border border-white/18 bg-white/10 px-7 py-4 text-center text-sm font-semibold text-white backdrop-blur-xl transition hover:-translate-y-0.5 hover:bg-white/16">Wyślij zapytanie</a>
      </div>

    </div>
  </div>

  <div class="pointer-events-none absolute bottom-0 left-1/2 z-0 h-[360px] w-full max-w-6xl -translate-x-1/2 overflow-hidden px-6 sm:h-[420px] lg:h-[480px]">
    <img
      src="/domzal-hero-new.webp"
      alt="Usługi geodezyjne Dawid Domżał – działka budowlana"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="absolute left-1/2 top-0 h-[150%] w-auto max-w-none -translate-x-1/2 -translate-y-[8%] sm:h-[160%] sm:-translate-y-[5%] lg:h-[170%] lg:-translate-y-[2%]"
    />
  </div>
</section>
