---
---
<section class="grain relative overflow-hidden bg-geo-900 text-white" id="top">
  <div class="absolute left-0 top-0 h-[520px] w-[520px] -translate-x-1/3 -translate-y-1/3 rounded-full bg-limebrand/20 blur-3xl"></div>
  <div class="relative z-10 grid min-h-[680px] lg:grid-cols-2">
    <div class="flex items-center px-6 py-16 lg:justify-end lg:px-14 lg:py-24">
      <div class="stagger-reveal reveal w-full max-w-[620px] lg:pr-10">
        <h1 class="max-w-3xl text-5xl font-semibold leading-[.95] tracking-[-0.055em] md:text-6xl lg:text-7xl">
          <span class="geo-word">Geodezja,</span> która porządkuje inwestycję od pierwszej mapy do odbioru.
        </h1>
        <p class="mt-7 max-w-xl text-base leading-7 text-white/68 md:text-lg">
          Mapy do celów projektowych, tyczenia budynków, podziały nieruchomości, inwentaryzacje powykonawcze i stała obsługa inwestycji. Konkretnie, terminowo i z jasnym planem działania.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="tel:+48501719855" class="rounded-full bg-limebrand px-7 py-4 text-center text-sm font-semibold text-geo-900 transition hover:-translate-y-0.5 hover:shadow-soft">Umów pomiar</a>
          <a href="mailto:domzal-dawid@wp.pl" class="rounded-full border border-white/18 bg-white/10 px-7 py-4 text-center text-sm font-semibold text-white backdrop-blur-xl transition hover:-translate-y-0.5 hover:bg-white/16">Wyślij zapytanie</a>
        </div>
        <div class="mt-9 grid max-w-xl grid-cols-3 gap-3 border-t border-white/12 pt-6 text-sm">
          <div>
            <p class="text-2xl font-semibold">Kalisz</p>
            <p class="mt-1 text-white/50">lokalna obsługa</p>
          </div>
          <div>
            <p class="text-2xl font-semibold">od A do Z</p>
            <p class="mt-1 text-white/50">teren i dokumenty</p>
          </div>
          <div>
            <p class="text-2xl font-semibold">1:1</p>
            <p class="mt-1 text-white/50">kontakt z geodetą</p>
          </div>
        </div>
      </div>
    </div>
    <div class="hero-media reveal relative min-h-[440px] lg:min-h-full">
      <picture>
        <source srcset="/domzal-hero.webp" type="image/webp" />
        <img src="/domzal-hero.jpg" alt="Geodeta podczas pracy z tachimetrem w terenie" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" />
      </picture>
    </div>
  </div>
</section>
