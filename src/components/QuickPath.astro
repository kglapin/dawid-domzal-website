---
---
<section id="proces" class="quick-section px-6 lg:px-14">
  <div class="quick-sticky">
    <div class="relative mx-auto w-full max-w-7xl py-16 lg:py-20">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[.36em] text-geo-600">Proces</p>
          <h2 class="mt-3 max-w-2xl text-3xl font-semibold leading-tight tracking-[-0.04em] md:text-4xl">
            Koniec z przestojami na budowie. Nasz proces chroni Twój harmonogram.
          </h2>
        </div>
        <p class="max-w-xl text-base leading-7 text-black/66 lg:text-right">
          Krok po kroku, bez zgadywania.<br />Wiesz, co robimy, kiedy i co dostajesz na koniec.
        </p>
      </div>

      <div class="process-bar mt-10 h-2 rounded-full"></div>

      <div class="steps-grid mt-8 grid gap-4 md:grid-cols-3" role="tablist" aria-label="Etapy procesu">
        <article class="step-card is-active rounded-[1.5rem] bg-white p-7 shadow-card" data-step-card="1" role="tab" tabindex="0" aria-selected="true" aria-current="step" aria-controls="quick-panel-1">
          <p class="text-sm font-semibold text-geo-700">01</p>
          <h3 class="mt-6 text-xl font-semibold tracking-[-0.02em]">Dzwonisz i podajesz adres</h3>
          <p class="mt-3 text-sm leading-6 text-black/55">Nie szukaj numerów działek i obrębów. Powiedz, co chcesz zrobić, wyślij nam pinezkę z telefonu — a my sprawdzimy resztę.</p>
        </article>

        <article class="step-card rounded-[1.5rem] bg-white p-7 shadow-card" data-step-card="2" role="tab" tabindex="0" aria-selected="false" aria-controls="quick-panel-2">
          <p class="text-sm font-semibold text-geo-700">02</p>
          <h3 class="mt-6 text-xl font-semibold tracking-[-0.02em]">Konkretny termin w terenie</h3>
          <p class="mt-3 text-sm leading-6 text-black/55">Wchodzimy na działkę w ustalonym dniu. Bez wymówek i opóźnień, które mogłyby zablokować pracę Twojej ekipy.</p>
        </article>

        <article class="step-card rounded-[1.5rem] bg-limebrand p-7 shadow-card" data-step-card="3" role="tab" tabindex="0" aria-selected="false" aria-controls="quick-panel-3">
          <p class="text-sm font-semibold text-geo-900">03</p>
          <h3 class="mt-6 text-xl font-semibold tracking-[-0.02em]">Gotowa dokumentacja w Twoich rękach</h3>
          <p class="mt-3 text-sm leading-6 text-geo-900/68">Przekazujemy gotowe, uporządkowane materiały papierowe i cyfrowe. Możesz ruszać z budową, projektowaniem lub odbiorem.</p>
        </article>
      </div>

      <div class="quick-connector-layer" aria-hidden="true">
        <span class="connector-line-glow"></span>
        <span class="connector-line"></span>
        <span class="connector-dock"></span>
      </div>

      <div class="story-area">
        <div class="story-panel">
          <article class="panel-state is-active" data-panel="1" id="quick-panel-1" role="tabpanel">
            <div class="panel-head">
              <div>
                <p class="panel-eyebrow">Krok 01</p>
                <h4 class="panel-title">Dzwonisz i podajesz adres — resztę sprawdzamy my.</h4>
              </div>
              <span class="panel-badge start">start</span>
            </div>
            <div class="panel-body">
              <p class="panel-lead">Nie szukaj numerów działek i obrębów. Powiedz, co chcesz zrobić, wyślij nam pinezkę z telefonu — a my sprawdzimy resztę w systemach urzędowych i od razu wracamy z wyceną i planem.</p>
              <div class="info-grid">
                <div class="info-card">
                  <p class="info-label">Co podajesz?</p>
                  <p class="info-text">adres, pinezkę lub cel inwestycji</p>
                </div>
                <div class="info-card">
                  <p class="info-label">Co robimy?</p>
                  <p class="info-text">weryfikujemy działkę w systemach urzędowych</p>
                </div>
                <div class="info-card highlight">
                  <p class="info-label">Efekt</p>
                  <p class="info-text">jasna wycena i plan działania</p>
                </div>
              </div>
              <div class="panel-tags">
                <span class="panel-tag">lokalizacja</span>
                <span class="panel-tag">cel inwestycji</span>
                <span class="panel-tag">pinezka z telefonu</span>
              </div>
            </div>
          </article>

          <article class="panel-state" data-panel="2" id="quick-panel-2" role="tabpanel" hidden>
            <div class="panel-head">
              <div>
                <p class="panel-eyebrow">Krok 02</p>
                <h4 class="panel-title">W ustalonym dniu jesteśmy na działce.</h4>
              </div>
              <span class="panel-badge">plan</span>
            </div>
            <div class="panel-body">
              <p class="panel-lead">Wchodzimy na działkę w ustalonym dniu. Bez wymówek i opóźnień, które mogłyby zablokować pracę Twojej ekipy budowlanej.</p>
              <div class="info-grid">
                <div class="info-card">
                  <p class="info-label">Co robimy?</p>
                  <p class="info-text">wykonujemy pomiar w terenie</p>
                </div>
                <div class="info-card">
                  <p class="info-label">Jak działamy?</p>
                  <p class="info-text">bez opóźnień i wymówek</p>
                </div>
                <div class="info-card highlight">
                  <p class="info-label">Efekt</p>
                  <p class="info-text">Twoja ekipa nie czeka ani dnia</p>
                </div>
              </div>
              <div class="panel-tags">
                <span class="panel-tag">termin w terenie</span>
                <span class="panel-tag">pomiar</span>
                <span class="panel-tag">bez opóźnień</span>
                <span class="panel-tag">ustalony dzień</span>
              </div>
            </div>
          </article>

          <article class="panel-state" data-panel="3" id="quick-panel-3" role="tabpanel" hidden>
            <div class="panel-head">
              <div>
                <p class="panel-eyebrow">Krok 03</p>
                <h4 class="panel-title">Gotowe materiały zamykają sprawę.</h4>
              </div>
              <span class="panel-badge">OK</span>
            </div>
            <div class="panel-body">
              <p class="panel-lead">Przekazujemy gotowe, uporządkowane materiały papierowe i cyfrowe. Możesz ruszać z budową, projektowaniem lub odbiorem.</p>
              <div class="info-grid">
                <div class="info-card">
                  <p class="info-label">Co robimy?</p>
                  <p class="info-text">opracowujemy dokumentację</p>
                </div>
                <div class="info-card">
                  <p class="info-label">Co powstaje?</p>
                  <p class="info-text">papierowe i cyfrowe materiały</p>
                </div>
                <div class="info-card highlight">
                  <p class="info-label">Efekt</p>
                  <p class="info-text">możesz budować, projektować lub odbierać</p>
                </div>
              </div>
              <div class="panel-tags">
                <span class="panel-tag">dokumentacja</span>
                <span class="panel-tag">pliki cyfrowe</span>
                <span class="panel-tag highlight">gotowe materiały</span>
              </div>
            </div>
          </article>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function() {
    var section = document.querySelector('#proces');
    var panel = document.querySelector('.story-panel');
    var storyArea = document.querySelector('.story-area');
    var connectorLayer = document.querySelector('.quick-connector-layer');
    var cards = Array.from(document.querySelectorAll('[data-step-card]'));
    var panels = Array.from(document.querySelectorAll('[data-panel]'));
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var ticking = false;
    var current = null;
    var isMobile = window.innerWidth < 1024;
    var pendingDrawFrame = 0;

    function clamp(value, min, max) {
      if (min === undefined) min = 0;
      if (max === undefined) max = 1;
      return Math.min(Math.max(value, min), max);
    }

    function getStep(progress) {
      if (progress < 0.34) return 1;
      if (progress < 0.68) return 2;
      return 3;
    }

    function getCurrentProgress() {
      if (!section) return 0;
      var rect = section.getBoundingClientRect();
      var distance = Math.max(section.offsetHeight - window.innerHeight, 1);
      return clamp(-rect.top / distance);
    }

    function updateConnection(step, shouldAnimate) {
      var activeCard = cards.find(function(card) { return Number(card.dataset.stepCard) === step; });
      if (!activeCard || !panel || !connectorLayer || window.innerWidth < 1024) return;

      var cardRect = activeCard.getBoundingClientRect();
      var layerRect = connectorLayer.getBoundingClientRect();
      var panelRect = panel.getBoundingClientRect();

      if (!layerRect.width || !panelRect.width || !cardRect.width) return;

      var connectorX = cardRect.left + cardRect.width / 2 - layerRect.left;
      var connectorStart = cardRect.bottom + 18 - layerRect.top;
      var panelTop = panelRect.top - layerRect.top;
      var connectorHeight = Math.max(panelTop - connectorStart, 0);

      connectorLayer.style.setProperty('--connector-x', connectorX + 'px');
      connectorLayer.style.setProperty('--connector-start', connectorStart + 'px');
      connectorLayer.style.setProperty('--connector-height', connectorHeight + 'px');

      if (shouldAnimate && !reduce.matches) {
        window.cancelAnimationFrame(pendingDrawFrame);
        connectorLayer.style.setProperty('--connector-draw', '0');
        pendingDrawFrame = window.requestAnimationFrame(function() {
          connectorLayer.style.setProperty('--connector-draw', '1');
        });
      } else {
        connectorLayer.style.setProperty('--connector-draw', '1');
      }
    }

    function setActive(step, options) {
      options = options || {};
      var shouldAnimate = Boolean(options.animate);
      var changed = step !== current;
      current = step;

      cards.forEach(function(card) {
        var isActive = Number(card.dataset.stepCard) === step;
        card.classList.toggle('is-active', isActive);
        card.setAttribute('aria-selected', String(isActive));
        if (isActive) {
          card.setAttribute('aria-current', 'step');
        } else {
          card.removeAttribute('aria-current');
        }
      });

      panels.forEach(function(item) {
        var isActive = Number(item.dataset.panel) === step;
        item.classList.toggle('is-active', isActive);
        item.hidden = isMobile ? false : !isActive;
      });

      var isDark = step === 3;
      if (panel) panel.classList.toggle('is-dark', isDark);
      if (storyArea) storyArea.classList.toggle('is-dark', isDark);
      if (connectorLayer) connectorLayer.classList.toggle('is-dark', isDark);

      if (!isMobile) updateConnection(step, shouldAnimate || changed);
    }

    function update() {
      ticking = false;
      if (!section) return;

      isMobile = window.innerWidth < 1024;

      if (reduce.matches) {
        section.style.setProperty('--progress', '1');
        section.style.setProperty('--grid-y', '0px');
        setActive(1, { animate: false });
        return;
      }

      if (isMobile) {
        section.style.setProperty('--progress', '1');
        section.style.setProperty('--grid-y', '0px');
        panels.forEach(function(item) { item.hidden = false; });
        return;
      }

      var progress = getCurrentProgress();
      var step = getStep(progress);

      section.style.setProperty('--progress', progress.toFixed(4));
      section.style.setProperty('--grid-y', (progress * -24).toFixed(2) + 'px');
      setActive(step, { animate: step !== current });
    }

    function requestUpdate() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    }

    function initializeAfterLayout() {
      setTimeout(function() {
        current = null;
        update();
      }, 100);
    }

    cards.forEach(function(card) {
      card.addEventListener('click', function() {
        var step = Number(card.dataset.stepCard);
        setActive(step, { animate: true });
      });
      card.addEventListener('keydown', function(event) {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        var step = Number(card.dataset.stepCard);
        setActive(step, { animate: true });
      });
    });

    initializeAfterLayout();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', function() { current = null; requestUpdate(); });
    reduce.addEventListener('change', function() { current = null; requestUpdate(); });
  })();
</script>
