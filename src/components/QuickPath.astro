---
---
<section id="proces" class="process-section bg-geo-50 px-6 py-16 lg:px-14 lg:py-24">
  <div class="mx-auto max-w-7xl">
    <div class="mb-10">
      <p class="text-sm font-semibold uppercase tracking-[.36em] text-geo-600">Proces</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-semibold leading-tight tracking-[-0.04em] md:text-4xl">
        Mniej ryzyka przestojów na budowie.
      </h2>
    </div>

    <div class="process-progress mb-10 h-1 w-full max-w-2xl overflow-hidden rounded-full bg-geo-900/10">
      <div class="process-progress__bar h-full w-full rounded-full bg-gradient-to-r from-geo-900 to-limebrand"></div>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      <article class="process-card rounded-[1.5rem] bg-white p-7 shadow-card" data-step="1">
        <p class="process-card__num text-sm font-semibold text-geo-700">01</p>
        <h3 class="mt-6 text-xl font-semibold tracking-[-0.02em]">Kontaktujesz się ze mną</h3>
        <p class="mt-3 text-sm leading-6 text-black/55">Opisz sprawę i wyślij lokalizację działki, nawet jako pinezkę z telefonu.</p>
      </article>

      <article class="process-card rounded-[1.5rem] bg-white p-7 shadow-card" data-step="2">
        <p class="process-card__num text-sm font-semibold text-geo-700">02</p>
        <h3 class="mt-6 text-xl font-semibold tracking-[-0.02em]">Ustalamy zakres i termin</h3>
        <p class="mt-3 text-sm leading-6 text-black/55">Sprawdzam, czego potrzebujesz, i potwierdzam termin prac w terenie.</p>
      </article>

      <article class="process-card rounded-[1.5rem] bg-limebrand p-7 shadow-card" data-step="3">
        <p class="process-card__num text-sm font-semibold text-geo-900">03</p>
        <h3 class="mt-6 text-xl font-semibold tracking-[-0.02em]">Otrzymujesz dokumentację</h3>
        <p class="mt-3 text-sm leading-6 text-geo-900/68">Przekazuję materiały w wersji papierowej lub cyfrowej, zależnie od ustaleń.</p>
      </article>
    </div>
  </div>

  <script is:inline>
    (function() {
      var section = document.getElementById('proces');
      if (!section) return;
      var cards = Array.from(section.querySelectorAll('.process-card'));
      var bar = section.querySelector('.process-progress__bar');
      var ticking = false;

      function clamp(value, min, max) {
        if (min === undefined) min = 0;
        if (max === undefined) max = 1;
        return Math.min(Math.max(value, min), max);
      }

      function update() {
        ticking = false;
        if (!section) return;

        var rect = section.getBoundingClientRect();
        var vh = window.innerHeight;
        var total = rect.height + vh;
        var progress = clamp((vh - rect.top) / total);

        if (bar) bar.style.transform = 'scaleX(' + progress + ')';

        cards.forEach(function(card, i) {
          var start = 0.04 + (i * 0.16);
          var range = 0.22;
          var local = clamp((progress - start) / range);

          var opacity = local;
          var translateY = 32 * (1 - local);
          var scale = 0.98 + (0.02 * local);
          var blur = 4 * (1 - local);

          card.style.opacity = opacity.toFixed(3);
          card.style.transform = 'translateY(' + translateY.toFixed(2) + 'px) scale(' + scale.toFixed(3) + ')';
          card.style.filter = 'blur(' + blur.toFixed(2) + 'px)';
        });
      }

      function requestUpdate() {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(update);
      }

      window.addEventListener('scroll', requestUpdate, { passive: true });
      window.addEventListener('resize', requestUpdate, { passive: true });
      requestUpdate();
    })();
  </script>
</section>
