---
---
<footer class="grain relative bg-geo-900 px-6 py-14 text-white lg:px-14 lg:py-16">
  <div class="mx-auto max-w-7xl">

    <!-- 4-column grid -->
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">

      <!-- Col 1: Brand -->
      <div>
        <a href="#top" class="flex items-center gap-3">
          <img src="/domzal-logo.webp" alt="Dawid Domżał – logo" class="h-9 w-9 shrink-0 rounded-full object-cover" loading="lazy" />
          <span>
            <span class="block text-sm font-semibold text-white">Dawid Domżał</span>
            <span class="block text-[11px] uppercase tracking-[.22em] text-white/40">Geodezja i kursy ADR</span>
          </span>
        </a>
        <p class="mt-5 text-sm leading-6 text-white/50">Kompleksowa obsługa geodezyjna inwestycji oraz szkolenia ADR dla kierowców. Konkretnie, terminowo i z jasnym planem działania.</p>
        <div class="mt-5 flex items-center gap-2 text-sm text-white/40">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>Pn – Pt 8:00 – 18:00</span>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-[.18em] text-white/30">Nawigacja</h3>
        <nav class="mt-5 flex flex-col gap-3">
          <a href="#sytuacje" class="text-sm text-white/55 transition-colors hover:text-limebrand">Sytuacje</a>
          <a href="#uslugi" class="text-sm text-white/55 transition-colors hover:text-limebrand">Usługi geodezyjne</a>
          <a href="#adr" class="text-sm text-white/55 transition-colors hover:text-limebrand">Kursy ADR</a>
          <a href="#proces" class="text-sm text-white/55 transition-colors hover:text-limebrand">Proces</a>
          <a href="#faq" class="text-sm text-white/55 transition-colors hover:text-limebrand">FAQ</a>
          <a href="#kontakt" class="text-sm text-white/55 transition-colors hover:text-limebrand">Kontakt</a>
        </nav>
      </div>

      <!-- Col 3: Contact -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-[.18em] text-white/30">Kontakt</h3>
        <div class="mt-5 flex flex-col gap-4">
          <a href="tel:+48501719855" class="flex items-center gap-3 text-sm text-white/55 transition-colors hover:text-limebrand">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            501 719 855
          </a>
          <a href="mailto:domzal-dawid@wp.pl" class="flex items-center gap-3 text-sm text-white/55 transition-colors hover:text-limebrand">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            domzal-dawid@wp.pl
          </a>
          <div class="flex items-start gap-3 text-sm text-white/55">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-1 shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>ul. 29 Pułku Piechoty 11<br/>62-800 Kalisz</span>
          </div>
          <a href="https://www.facebook.com/UslugiGeodezyjneDawidDomzal/" target="_blank" rel="noopener" class="flex items-center gap-3 text-sm text-white/55 transition-colors hover:text-limebrand">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            Facebook
          </a>
          <p class="text-xs text-white/30">Odpowiadamy w ciągu kilku godzin</p>
        </div>
      </div>

      <!-- Col 4: Area -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-[.18em] text-white/30">Obszar działania</h3>
        <p class="mt-5 text-sm text-white/50">Kalisz i okolice — dojeżdżamy na obiekt w całym regionie.</p>
        <div class="mt-4 rounded-[1.2rem] bg-white/6 p-4">
          <div class="flex flex-wrap gap-x-3 gap-y-1 text-sm text-white/55">
            <span>Kalisz</span>
            <span class="text-white/20">&middot;</span>
            <span>Ostrów Wlkp.</span>
            <span class="text-white/20">&middot;</span>
            <span>Krotoszyn</span>
            <span class="text-white/20">&middot;</span>
            <span>Pleszew</span>
            <span class="text-white/20">&middot;</span>
            <span>Syców</span>
            <span class="text-white/20">&middot;</span>
            <span>Odolanów</span>
            <span class="text-white/20">&middot;</span>
            <span>i sąsiednie gminy</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="mt-12 flex flex-col gap-4 border-t border-white/8 pt-6 text-sm text-white/32 md:flex-row md:items-center md:justify-between">
      <p>&copy; 2026 Usługi Geodezyjne Dawid Domżał</p>
      <div class="flex gap-5">
        <a href="/polityka-prywatnosci" class="transition-colors hover:text-limebrand">Polityka prywatności</a>
        <a href="/rodo" class="transition-colors hover:text-limebrand">RODO</a>
      </div>
    </div>

  </div>
</footer>
