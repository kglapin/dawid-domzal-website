---
const geodesyServices = [
  {
    number: "01",
    title: "Mapy do celów projektowych",
    description: "Mapy w formie analogowej i numerycznej pod budowę obiektów budowlanych, sieci, przyłączy oraz innych elementów zagospodarowania terenu."
  },
  {
    number: "02",
    title: "Tyczenia i prace realizacyjne",
    description: "Tyczenie obiektów budowlanych i liniowych, osi konstrukcyjnych, sieci, przyłączy oraz pozostałych elementów inwestycji zgodnie z dokumentacją projektową."
  },
  {
    number: "03",
    title: "Geodezyjna obsługa inwestycji",
    description: "Stała obsługa geodezyjna obiektów kubaturowych — od przygotowania i tyczenia, przez kontrolę realizacji, aż po dokumentację powykonawczą."
  },
  {
    number: "04",
    title: "Podziały nieruchomości",
    description: "Kompleksowe przygotowanie i przeprowadzenie procedury podziału działek wraz z wymaganą dokumentacją geodezyjną."
  },
  {
    number: "05",
    title: "Granice i znaki graniczne",
    description: "Wznowienia znaków granicznych, wyznaczenia punktów ujawnionych wcześniej w ewidencji gruntów i budynków oraz ustalanie przebiegu granic działek ewidencyjnych."
  },
  {
    number: "06",
    title: "Inwentaryzacje powykonawcze",
    description: "Pomiary powykonawcze obiektów budowlanych, sieci, przyłączy i innych elementów zagospodarowania terenu potrzebne do zakończenia inwestycji."
  },
  {
    number: "07",
    title: "Geodezja inżynieryjna",
    description: "Specjalistyczne pomiary suwnic, słupów, posadzek, zapór, mostów i innych konstrukcji wymagających precyzyjnej kontroli geometrii."
  },
  {
    number: "08",
    title: "Dokumentacja do warunków zabudowy",
    description: "Przygotowanie materiałów i dokumentacji geodezyjnej niezbędnej do uzyskania decyzji o warunkach zabudowy."
  }
];

const adrCourses = [
  {
    code: "ADR",
    title: "Szkolenie podstawowe",
    description: "Kurs podstawowy ADR dla kierowców przewożących towary niebezpieczne wszystkich klas objętych szkoleniem podstawowym."
  },
  {
    code: "CYSTERNY",
    title: "Szkolenie specjalistyczne",
    description: "Przygotowanie kierowców do bezpiecznego przewozu towarów niebezpiecznych w cysternach."
  },
  {
    code: "KLASA 1",
    title: "Materiały wybuchowe",
    description: "Szkolenie specjalistyczne dotyczące przewozu materiałów i przedmiotów wybuchowych."
  },
  {
    code: "KLASA 7",
    title: "Materiały promieniotwórcze",
    description: "Szkolenie specjalistyczne dla kierowców przewożących materiały promieniotwórcze."
  }
];
---
<section id="uslugi" class="relative px-6 py-16 lg:px-14 lg:py-24">
  <div class="pointer-events-none absolute bottom-20 z-[-1] -translate-x-1/2 scale-[3] opacity-20" style="left: max(1.5rem, calc((100% - 80rem)/2))">
    <img src="/services-bg.webp" alt="" class="max-h-80 w-auto grayscale" />
  </div>

  <div class="relative z-1 mx-auto max-w-7xl">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)]">
      <div class="reveal lg:sticky lg:top-28 lg:self-start">
        <p class="text-sm font-semibold uppercase tracking-[.24em] text-geo-600">Zakres prac geodezyjnych</p>
        <h2 class="mt-4 max-w-md text-4xl font-semibold leading-tight tracking-[-0.04em] md:text-5xl">Pełna obsługa geodezyjna inwestycji — od mapy po odbiór.</h2>
        <p class="mt-5 max-w-md leading-7 text-black/58">Realizujemy zarówno typowe prace dla inwestorów prywatnych, jak i specjalistyczne pomiary dla firm, wykonawców i obiektów przemysłowych. Jeżeli nie masz pewności, czego potrzebujesz, opisz sprawę — dobierzemy właściwy zakres.</p>
        <a href="#kontakt" class="mt-7 inline-flex items-center gap-2 rounded-full bg-geo-900 px-6 py-3.5 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-geo-700">
          Zapytaj o zakres prac
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {geodesyServices.map((service) => (
          <article class="service-card reveal flex min-h-[250px] flex-col rounded-[1.6rem] border border-black/6 bg-white p-7 shadow-card">
            <div class="mb-8 flex items-center justify-between gap-4">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-geo-50 text-sm font-bold text-geo-700">{service.number}</span>
              <span class="h-px flex-1 bg-black/6"></span>
            </div>
            <h3 class="text-xl font-semibold tracking-[-0.02em]">{service.title}</h3>
            <p class="mt-3 text-sm leading-6 text-black/56">{service.description}</p>
          </article>
        ))}
      </div>
    </div>

    <div id="adr" class="grain reveal relative mt-20 overflow-hidden rounded-[2.2rem] bg-geo-900 p-8 text-white md:p-12 lg:p-16">
      <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-limebrand/18 blur-3xl"></div>
      <div class="relative z-1 grid gap-10 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[.24em] text-limebrand">Kursy ADR dla kierowców</p>
          <h2 class="mt-4 max-w-xl text-4xl font-semibold leading-tight tracking-[-0.04em] md:text-5xl">Przygotowanie do bezpiecznego przewozu towarów niebezpiecznych.</h2>
          <p class="mt-5 max-w-xl leading-7 text-white/62">Prowadzimy szkolenia podstawowe i specjalistyczne ADR. Zakres kursu dobieramy do rodzaju transportu oraz klas materiałów, które kierowca będzie przewoził.</p>
          <a href="#kontakt" class="mt-8 inline-flex items-center gap-2 rounded-full bg-limebrand px-6 py-3.5 text-sm font-semibold text-geo-900 transition hover:-translate-y-0.5 hover:shadow-soft">
            Zapytaj o najbliższy kurs
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {adrCourses.map((course) => (
            <article class="rounded-[1.5rem] border border-white/10 bg-white/8 p-6 backdrop-blur-sm">
              <p class="text-xs font-bold uppercase tracking-[.2em] text-limebrand">{course.code}</p>
              <h3 class="mt-5 text-xl font-semibold">{course.title}</h3>
              <p class="mt-3 text-sm leading-6 text-white/58">{course.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
