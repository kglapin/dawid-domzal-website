---
const geodesyServices = [
  {
    number: "01",
    title: "Mapy do celów projektowych",
    description: "W formie analogowej i numerycznej — pod budowę obiektów budowlanych, sieci, przyłączy itp.",
    icon: "/services-icons/map.svg"
  },
  {
    number: "02",
    title: "Tyczenia i prace realizacyjne",
    description: "Tyczenia obiektów budowlanych, obiektów liniowych, sieci, przyłączy itp.",
    icon: "/services-icons/map-pin.svg"
  },
  {
    number: "03",
    title: "Geodezyjna obsługa inwestycji",
    description: "Obsługa obiektów kubaturowych.",
    icon: "/services-icons/building-2.svg"
  },
  {
    number: "04",
    title: "Podziały nieruchomości",
    description: "Kompleksowe wykonanie prac i dokumentacji związanych z podziałem nieruchomości.",
    icon: "/services-icons/split.svg"
  },
  {
    number: "05",
    title: "Granice działek ewidencyjnych",
    description: "Wznowienia znaków granicznych, wyznaczenia punktów granicznych ujawnionych uprzednio w ewidencji gruntów i budynków oraz ustalenie przebiegu granic działek ewidencyjnych.",
    icon: "/services-icons/flag.svg"
  },
  {
    number: "06",
    title: "Inwentaryzacje powykonawcze",
    description: "Inwentaryzacje obiektów budowlanych, sieci, przyłączy i innych obiektów zagospodarowania terenu.",
    icon: "/services-icons/clipboard-list.svg"
  },
  {
    number: "07",
    title: "Pomiary związane z geodezją inżynieryjną",
    description: "Pomiary suwnic, słupów, posadzek, zapór, mostów itp.",
    icon: "/services-icons/ruler.svg"
  },
  {
    number: "08",
    title: "Dokumentacja do decyzji o warunkach zabudowy",
    description: "Przygotowanie dokumentacji niezbędnej do wydania decyzji o warunkach zabudowy.",
    icon: "/services-icons/file-text.svg"
  }
];
---
<section id="uslugi" class="relative px-6 py-16 lg:px-14 lg:py-24">
  <div class="pointer-events-none absolute bottom-20 z-[-1] -translate-x-1/2 scale-[3] opacity-20" style="left: max(1.5rem, calc((100% - 80rem)/2))">
    <img src="/services-bg.webp" alt="" class="max-h-80 w-auto grayscale" />
  </div>

  <div class="relative z-1 mx-auto max-w-7xl">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)]">
      <div class="reveal lg:sticky lg:top-28 lg:self-start">
        <p class="text-sm font-semibold uppercase tracking-[.24em] text-geo-600">Zakres prac geodezyjnych</p>
        <h2 class="mt-4 max-w-md text-4xl font-semibold leading-tight tracking-[-0.04em] md:text-5xl">Pełny zakres usług geodezyjnych dla inwestorów, wykonawców i firm.</h2>
        <p class="mt-5 max-w-md leading-7 text-black/58">Wykonuję prace od przygotowania map i wytyczenia inwestycji po pomiary powykonawcze.</p>
        <a href="#kontakt" class="mt-7 inline-flex items-center gap-2 rounded-full bg-geo-900 px-6 py-3.5 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-geo-700">
          Zapytaj o usługę geodezyjną
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {geodesyServices.map((service) => (
          <article class="service-card reveal relative flex min-h-[250px] flex-col overflow-hidden rounded-[1.6rem] border border-black/6 bg-white p-7 shadow-card">
            <div class="mb-8 flex items-center justify-between gap-4">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-geo-50 text-sm font-bold text-geo-700">{service.number}</span>
              <span class="h-px flex-1 bg-black/6"></span>
            </div>
            <h3 class="text-xl font-semibold tracking-[-0.02em]">{service.title}</h3>
            <p class="mt-3 text-sm leading-6 text-black/56">{service.description}</p>
            <img src={service.icon} alt="" class="pointer-events-none absolute -bottom-5 -right-5 h-36 w-36 opacity-10" loading="lazy" />
          </article>
        ))}
      </div>
    </div>

  </div>
</section>
