---
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || "YOUR_WEB3FORMS_KEY";
---
<section id="kontakt" class="px-6 py-16 lg:px-14 lg:py-24">
  <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
    <div class="reveal rounded-[2rem] bg-white p-8 shadow-card md:p-12">
      <p class="text-sm font-semibold uppercase tracking-[.24em] text-geo-600">Kontakt</p>
      <h2 class="mt-4 text-4xl font-semibold leading-tight tracking-[-0.04em] md:text-5xl">Porozmawiajmy o Twojej działce.</h2>
      <p class="mt-5 leading-7 text-black/58">Zadzwoń lub zostaw wiadomość. Po krótkiej rozmowie określę wstępny zakres prac, sprawdzę lokalizację i powiem, jakie będą kolejne kroki.</p>
      <div class="mt-8 space-y-3">
        <a href="tel:+48501719855" class="flex items-center justify-between rounded-2xl bg-[#f5f5f0] p-5 transition hover:bg-limebrand">
          <span>
            <span class="block text-xs uppercase tracking-[.18em] text-black/42">Telefon (kontakt)</span>
            <span class="mt-1 block font-semibold">501 719 855</span>
          </span>
          <span class="text-2xl">&rarr;</span>
        </a>
        <a href="mailto:domzal-dawid@wp.pl" class="flex items-center justify-between rounded-2xl bg-[#f5f5f0] p-5 transition hover:bg-limebrand">
          <span>
            <span class="block text-xs uppercase tracking-[.18em] text-black/42">E-mail</span>
            <span class="mt-1 block font-semibold">domzal-dawid@wp.pl</span>
          </span>
          <span class="text-2xl">&rarr;</span>
        </a>
        <div class="flex items-center justify-between rounded-2xl bg-[#f5f5f0] p-5">
          <span>
            <span class="block text-xs uppercase tracking-[.18em] text-black/42">Adres biura (NAP)</span>
            <span class="mt-1 block font-semibold text-sm sm:text-base text-black/80">ul. 29 Pułku Piechoty 11, 62-800 Kalisz</span>
          </span>
          <span class="text-xl">📍</span>
        </div>
      </div>
    </div>

    <form id="contact-form" class="reveal rounded-[2rem] bg-geo-900 p-8 text-white shadow-card md:p-12" action="https://api.web3forms.com/submit" method="POST">
      <div class="grid gap-5">
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value="Nowe zapytanie ze strony Dawid Domżał" />
        <input type="hidden" name="from_name" value="Formularz kontaktowy" />
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />
        <label>
          <span class="text-sm text-white/70">Imię i nazwisko</span>
          <input name="Imie_i_nazwisko" required class="mt-2 w-full rounded-2xl border border-white/10 bg-white/8 px-5 py-4 text-white outline-none focus:border-limebrand" placeholder="Jan Kowalski" />
        </label>
        <label>
          <span class="text-sm text-white/70">Numer telefonu</span>
          <input type="tel" name="Telefon" required class="mt-2 w-full rounded-2xl border border-white/10 bg-white/8 px-5 py-4 text-white outline-none focus:border-limebrand" placeholder="np. 500 000 000" />
        </label>
        <label>
          <span class="text-sm text-white/70">Adres e-mail</span>
          <input type="email" name="Email" class="mt-2 w-full rounded-2xl border border-white/10 bg-white/8 px-5 py-4 text-white outline-none focus:border-limebrand" placeholder="np. jan@example.com" />
        </label>
        <label>
          <span class="text-sm text-white/70">Opis</span>
          <textarea name="Opis" rows="5" class="mt-2 w-full resize-none rounded-2xl border border-white/10 bg-white/8 px-5 py-4 text-white outline-none focus:border-limebrand" placeholder="Napisz, czego dotyczy sprawa i gdzie znajduje się działka."></textarea>
        </label>
        <label class="flex items-start gap-3 text-sm text-white/70">
          <input type="checkbox" name="zgoda_rodo" required class="mt-1 h-4 w-4 accent-limebrand" />
          <span>Wyrażam zgodę na przetwarzanie danych osobowych zgodnie z <a href="/polityka-prywatnosci" class="text-limebrand underline hover:no-underline">polityką prywatności</a> i RODO.</span>
        </label>
        <button type="submit" class="rounded-full bg-limebrand px-7 py-4 text-sm font-semibold text-geo-900 transition hover:-translate-y-0.5">Zapytaj o wstępną wycenę</button>
        <div id="form-status" class="text-sm"></div>
      </div>
    </form>

    <script is:inline>
      (function() {
        var form = document.getElementById('contact-form');
        var status = document.getElementById('form-status');
        if (!form || !status) return;
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          var submitBtn = form.querySelector('button[type="submit"]');
          var originalText = submitBtn.textContent;
          submitBtn.disabled = true;
          submitBtn.textContent = 'Wysyłanie...';
          status.textContent = '';
          status.className = 'text-sm';
          fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            body: new FormData(form)
          })
          .then(function(response) { return response.json(); })
          .then(function(data) {
            if (data.success) {
              status.textContent = 'Dziękuję za wiadomość. Odezwę się najszybciej jak to możliwe.';
              status.className = 'text-sm text-limebrand';
              form.reset();
            } else {
              status.textContent = 'Nie udało się wysłać wiadomości. Spróbuj ponownie lub zadzwoń: 501 719 855.';
              status.className = 'text-sm text-red-300';
            }
          })
          .catch(function() {
            status.textContent = 'Błąd połączenia. Zadzwoń: 501 719 855.';
            status.className = 'text-sm text-red-300';
          })
          .finally(function() {
            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
          });
        });
      })();
    </script>
  </div>
</section>
