---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Usługi Geodezyjne Dawid Domżał - Geodeta Kalisz",
  description = "Usługi geodezyjne w Kaliszu i okolicach: mapy do celów projektowych, tyczenia budynków, podziały działek, inwentaryzacje powykonawcze i obsługa inwestycji."
} = Astro.props;

import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="pl" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://images.unsplash.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <link rel="preload" as="image" href="/domzal-hero.webp" type="image/webp" fetchpriority="high" />

  <meta property="og:title" content="Usługi Geodezyjne Dawid Domżał" />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Usługi Geodezyjne Dawid Domżał",
    "description": description,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Kalisz",
      "addressRegion": "Wielkopolskie",
      "addressCountry": "PL"
    },
    "telephone": "+48501719855",
    "email": "domzal-dawid@wp.pl",
    "areaServed": {
      "@type": "AdministrativeArea",
      "name": "Kalisz i okolice"
    },
    "serviceType": [
      "Mapy do celów projektowych",
      "Tyczenie budynków i sieci",
      "Podziały nieruchomości",
      "Inwentaryzacje powykonawcze"
    ]
  })} />
</head>
<body class="overflow-x-hidden bg-[#fbfbf8] text-ink antialiased font-['Inter',sans-serif]">
  <div class="scroll-progress" aria-hidden="true"></div>
  <noscript>
    <style>
      .reveal,.stagger-reveal>*{opacity:1!important;transform:none!important;filter:none!important}
      .quick-path-line:before{transform:scaleX(1)!important}
    </style>
  </noscript>
  <slot />

  <script>
    (() => {
      if ((window as any).__geoScrollAnimationInit) return;
      (window as any).__geoScrollAnimationInit = true;

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      const bar = document.querySelector('.scroll-progress') as HTMLElement | null;
      const hero = document.querySelector('.hero-media') as HTMLElement | null;
      const topo = document.querySelector('.topo-section') as HTMLElement | null;
      const reveals = Array.from(document.querySelectorAll('.reveal, .stagger-reveal'));
      const parallax = Array.from(document.querySelectorAll('.parallax-card'));
      let ticking = false;

      const clamp = (value: number, min = 0, max = 1) => Math.min(Math.max(value, min), max);

      function setStaticState() {
        reveals.forEach((el) => el.classList.add('is-visible'));
        if (bar) bar.style.setProperty('--scroll-progress', '1');
        parallax.forEach((card) => (card as HTMLElement).style.setProperty('--parallax-y', '0'));
      }

      function updateScrollEffects() {
        ticking = false;

        const maxScroll = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
        const pageProgress = clamp(window.scrollY / maxScroll);
        if (bar) {
          bar.style.setProperty('--scroll-progress', pageProgress.toFixed(4));
        }

        if (reduce.matches) return;

        if (hero) {
          const heroProgress = clamp(window.scrollY / Math.max(window.innerHeight, 1));
          hero.style.setProperty('--hero-y', heroProgress.toFixed(3));
        }

        parallax.forEach((card) => {
          const rect = card.getBoundingClientRect();
          const cardProgress = clamp((window.innerHeight - rect.top) / (window.innerHeight + rect.height));
          (card as HTMLElement).style.setProperty('--parallax-y', (cardProgress - 0.5).toFixed(3));
        });

        if (topo) {
          const rect = topo.getBoundingClientRect();
          const topoProgress = clamp((window.innerHeight - rect.top) / (window.innerHeight + rect.height));
          topo.style.setProperty('--topo-shift', topoProgress.toFixed(3));
        }
      }

      function requestUpdate() {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateScrollEffects);
      }

      if (reduce.matches) {
        setStaticState();
      } else if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, {
          threshold: 0.14,
          rootMargin: '0px 0px -8% 0px'
        });

        reveals.forEach((el) => observer.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-visible'));
      }

      updateScrollEffects();
      window.addEventListener('scroll', requestUpdate, { passive: true });
      window.addEventListener('resize', requestUpdate);

      if (reduce.addEventListener) {
        reduce.addEventListener('change', () => {
          if (reduce.matches) setStaticState();
          requestUpdate();
        });
      }
    })();
  </script>
</body>
</html>
