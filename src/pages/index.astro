---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Situations from "../components/Situations.astro";
import WhyWorth from "../components/WhyWorth.astro";
import Services from "../components/Services.astro";
import ADRSection from "../components/ADRSection.astro";
import QuickPath from "../components/QuickPath.astro";
import TestimonialHighlight from "../components/TestimonialHighlight.astro";
import FAQ from "../components/FAQ.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Geodeta Kalisz | Mapy do Celów Projektowych, Tyczenie, Podziały – Dawid Domżał"
  description="Usługi geodezyjne w Kaliszu i okolicach: mapy do celów projektowych, tyczenie budynków, podziały działek, inwentaryzacje powykonawcze. Terminowo i bez formalności."
  canonical="https://dawid-domzal-website.wasmer.app"
>
  <Nav />
  <main id="top">
    <Hero />
    <Situations />
    <WhyWorth />
    <TestimonialHighlight />
    <QuickPath />
    <Services />
    <ADRSection />
    <FAQ />
    <Contact />
  </main>
  <Footer />
</Layout>
